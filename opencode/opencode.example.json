{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "agentgateway": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Solo agentgateway",
      "options": {
        "baseURL": "https://YOUR-GATEWAY:4000/v1",
        "apiKey": "{env:AGW_API_KEY}"
      },
      "models": { "YOUR-MODEL": { "name": "YOUR-MODEL via agentgateway" } }
    }
  },
  "model": "agentgateway/YOUR-MODEL",
  "small_model": "agentgateway/YOUR-MODEL"
}
